{
  "expo": {
    "name": "FatiaMática",
    "slug": "fatiamatica",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fatiamatica",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "br.edu.ifpi.fatiamatica",
      "adaptiveIcon": {
        "backgroundColor": "#FBEAD2"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
